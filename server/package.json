    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": { "express": "^5.3.0", "mongodb": "^7.7.0", "helmet": "^8.1.0", "express-rate-limit": "^8.2.1" },
  "devDependencies": { "mongodb-memory-server": "^11.3.0" }
}
